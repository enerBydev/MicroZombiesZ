{
  "name": "microzombiesz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MicroZombiesZ — top-down zombie wave shooter (estilo SAS: Zombie Assault). Nuxt 4 + Arquitectura Hexagonal/DDD + TDD + Atomic Design.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "qa": "bash qa.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.0",
    "pinia": "^3.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "@storybook/vue3-vite": "^9.1.20",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "happy-dom": "^18.0.0",
    "nuxt": "^4.0.0",
    "storybook": "^9.1.20",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
